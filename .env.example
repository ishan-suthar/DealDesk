# Research provider: demo | anthropic | gemini
RESEARCH_PROVIDER=demo

# Anthropic API Configuration (optional for live mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_DEEP=claude-sonnet-5-5

# Gemini API Configuration (optional for live mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SEC EDGAR client (required for live EDGAR requests: Name email@domain.com)
SEC_USER_AGENT=DealDeskResearch user@example.com

# Daily search request cap across all jobs
DAILY_SEARCH_CAP=300

# SQLite Database file location
DATABASE_URL=deal_desk.db
